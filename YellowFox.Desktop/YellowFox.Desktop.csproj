<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/yellowfox.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <YellowFoxBuildInfoFile>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/YellowFoxBuildInfo.g.cs</YellowFoxBuildInfoFile>
  </PropertyGroup>

  <!-- Generates the build stamp with an inline C# task. It must stay managed MSBuild
       code so the project builds the same way on Windows, macOS and Linux. -->
  <UsingTask TaskName="GenerateYellowFoxBuildInfo" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CounterFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var buildNumber = 0;
        if (File.Exists(CounterFile))
        {
            var raw = File.ReadAllText(CounterFile).Trim();
            int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out buildNumber);
        }

        buildNumber++;
        var counterDirectory = Path.GetDirectoryName(CounterFile);
        if (!string.IsNullOrEmpty(counterDirectory))
            Directory.CreateDirectory(counterDirectory);
        File.WriteAllText(CounterFile, buildNumber.ToString(CultureInfo.InvariantCulture), new UTF8Encoding(false));

        var version = DateTime.Now.ToString("ddMMyy", CultureInfo.InvariantCulture)
            + "b" + buildNumber.ToString(CultureInfo.InvariantCulture);

        var outputDirectory = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrEmpty(outputDirectory))
            Directory.CreateDirectory(outputDirectory);
        var content = "// <auto-generated />" + Environment.NewLine
            + "namespace YellowFox.Desktop;" + Environment.NewLine + Environment.NewLine
            + "internal static class YellowFoxBuildInfo" + Environment.NewLine
            + "{" + Environment.NewLine
            + "    public const int BuildNumber = " + buildNumber.ToString(CultureInfo.InvariantCulture) + ";" + Environment.NewLine
            + "    public const string Version = \"" + version + "\";" + Environment.NewLine
            + "}" + Environment.NewLine;
        File.WriteAllText(OutputFile, content, new UTF8Encoding(true));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateYellowFoxBuildInfo" BeforeTargets="CoreCompile">
    <GenerateYellowFoxBuildInfo CounterFile="$(MSBuildProjectDirectory)/Properties/yellowfox-build.txt" OutputFile="$(YellowFoxBuildInfoFile)" />
    <ItemGroup>
      <Compile Include="$(YellowFoxBuildInfoFile)" AutoGen="True" Visible="False" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Folder Include="Models/" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../python/*.py;../python/*.js;../python/*.txt;../python/*.bat;../python/*.sh">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>python/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
    <None Include="../extensions/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>extensions/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.8" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.8" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.8">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.2.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
