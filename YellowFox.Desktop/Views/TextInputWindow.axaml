<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YellowFox.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="220"
        x:Class="YellowFox.Desktop.Views.TextInputWindow"
        x:DataType="vm:TextInputViewModel"
        Icon="/Assets/yellowfox.ico"
        Width="440"
        Height="230"
        CanResize="False"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner"
        Background="#252526">

    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,24,0,0">
            <Button AutomationProperties.AutomationId="TextInputSaveButton"
                    Width="130"
                    Height="40"
                    Click="SaveButton_Click"
                    IsDefault="True"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="8"
                    FontWeight="SemiBold"
                    FontSize="14"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                    <TextBlock Text="OK" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button AutomationProperties.AutomationId="TextInputCancelButton"
                    Width="130"
                    Height="40"
                    Click="CancelButton_Click"
                    IsCancel="True"
                    Background="#3E3E42"
                    Foreground="#CCCCCC"
                    BorderThickness="0"
                    CornerRadius="8"
                    FontWeight="SemiBold"
                    FontSize="14"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                    <TextBlock Text="Cancel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Spacing="12">
            <TextBlock Text="{Binding Prompt}"
                       Foreground="#CCCCCC"
                       FontWeight="SemiBold"
                       FontSize="13"
                       TextWrapping="Wrap" />
            <TextBox x:Name="ValueTextBox"
                     AutomationProperties.AutomationId="TextInputValueBox"
                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="{Binding Watermark}"
                     Background="#1E1E1E"
                     Foreground="#CCCCCC"
                     BorderBrush="#3E3E42"
                     Padding="12,10"
                     CornerRadius="6" />
        </StackPanel>
    </DockPanel>
</Window>
