<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YellowFox.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1000"
             d:DesignHeight="700"
             x:Class="YellowFox.Desktop.Views.TagsView"
             x:DataType="vm:TagsViewModel"
             Background="#1E1E1E">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="#2D2D2D"
                BorderBrush="#3E3E42"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="NewTagButton"
                        Content="➕ New"
                        Command="{Binding NewTagCommand}"
                        Padding="14,7"
                        Background="#4CAF50"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="5" />
                <Button AutomationProperties.AutomationId="EditTagButton"
                        Content="✏️ Edit"
                        Command="{Binding EditTagCommand}"
                        Padding="14,7"
                        Background="#3E3E42"
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        CornerRadius="5"
                        IsEnabled="{Binding HasSelection}" />
                <Button AutomationProperties.AutomationId="DeleteTagButton"
                        Content="🗑️ Delete"
                        Command="{Binding DeleteTagCommand}"
                        Padding="14,7"
                        Background="#A33A3A"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="5"
                        IsEnabled="{Binding HasSelection}" />
                <Button AutomationProperties.AutomationId="TagsRefreshButton"
                        Content="🔄 Refresh"
                        Command="{Binding RefreshCommand}"
                        Padding="14,7"
                        Background="#3E3E42"
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        CornerRadius="5" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1"
                  AutomationProperties.AutomationId="TagsList"
                  ItemsSource="{Binding Tags}"
                  SelectedItem="{Binding SelectedTag}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="#1E1E1E"
                  Foreground="#CCCCCC"
                  BorderBrush="#3E3E42"
                  RowBackground="#1E1E1E"
                  HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  CanUserResizeColumns="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Tag" Width="2*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:TagItemViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="4,2">
                                <Border Width="26"
                                        Height="26"
                                        CornerRadius="7"
                                        Background="{Binding ColorBrush}">
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           Foreground="#DDDDDD"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="0,1,0,0"
                Padding="12,10">
            <TextBlock Foreground="#AAAAAA" TextWrapping="Wrap">
                <Run Text="Status: " />
                <Run Text="{Binding StatusMessage}" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
