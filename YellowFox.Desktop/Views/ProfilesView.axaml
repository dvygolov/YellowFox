<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YellowFox.Desktop.ViewModels"
             xmlns:converters="using:YellowFox.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="YellowFox.Desktop.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel"
             Background="#1E1E1E">
    
    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="StatusColorConverter" />
    </UserControl.Resources>
    
    <UserControl.Styles>
        <Style Selector="Button.PrimaryAction">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
        <Style Selector="Button.PrimaryAction:pointerover">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="Button.SecondaryAction">
            <Setter Property="Background" Value="#2E3132" />
            <Setter Property="BorderBrush" Value="#3E3E42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#D0D0D0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.SecondaryAction:pointerover">
            <Setter Property="Background" Value="#3A3E40" />
            <Setter Property="BorderBrush" Value="#5A5F63" />
        </Style>
        <Style Selector="Button.FolderAction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#9AA2AA" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.FolderAction:pointerover">
            <Setter Property="Background" Value="#3A3E40" />
            <Setter Property="Foreground" Value="#E0E0E0" />
        </Style>
        <Style Selector="TextBox.ProfileNotesTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#B6BDC4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#B6BDC4" />
            <Setter Property="SelectionBrush" Value="#315E96" />
        </Style>
        <Style Selector="Button.NotesToggle">
            <Setter Property="Background" Value="#34383C" />
            <Setter Property="BorderBrush" Value="#4A5158" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#D0D6DC" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.NotesHost:pointerover Button.NotesToggle">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.NotesToggle:pointerover">
            <Setter Property="Background" Value="#3E454B" />
            <Setter Property="BorderBrush" Value="#69737C" />
        </Style>
    </UserControl.Styles>
    
    <DockPanel>
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top" 
                Background="#2D2D2D" 
                BorderBrush="#3E3E42" 
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <!-- Left: New Profile Button -->
                <Button Grid.Column="0"
                        AutomationProperties.AutomationId="NewProfileButton"
                        Content="➕ New Profile" 
                        Command="{Binding NewProfileCommand}"
                        Padding="16,8"
                        FontWeight="SemiBold"
                        Background="#4CAF50"
                        Foreground="White"
                        CornerRadius="6"
                        BorderThickness="0" />

                <!-- Left: New Folder Button -->
                <Button Grid.Column="1"
                        AutomationProperties.AutomationId="NewFolderButton"
                        Content="📁 New Folder" 
                        Command="{Binding NewFolderCommand}"
                        Padding="16,8"
                        Margin="10,0,0,0"
                        FontWeight="SemiBold"
                        Background="#357ABD"
                        Foreground="White"
                        CornerRadius="6"
                        BorderThickness="0" />
                
                <!-- Center: Search Box -->
                <TextBox Grid.Column="2"
                         AutomationProperties.AutomationId="ProfilesSearchInput"
                         Width="400"
                         Margin="20,0"
                         HorizontalAlignment="Center"
                         Watermark="🔍 Search profiles..." 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center"
                         Padding="12,8"
                         Background="#252526"
                         Foreground="#CCCCCC"
                         BorderBrush="#3E3E42"
                         CornerRadius="6" />
                
                <!-- Right: View options + Refresh -->
                <Button Grid.Column="3"
                        AutomationProperties.AutomationId="ProfilesViewOptionsButton"
                        Content="👁 View"
                        Padding="12,8"
                        Margin="0,0,8,0"
                        Background="#3E3E42"
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        CornerRadius="6"
                        ToolTip.Tip="Tree columns">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Proxy"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowProxy, Mode=TwoWay}" />
                            <MenuItem Header="Notes"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowNotes, Mode=TwoWay}" />
                            <MenuItem Header="Tags"
                                      ToggleType="CheckBox"
                                      IsChecked="{Binding ShowTags, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button Grid.Column="4"
                        AutomationProperties.AutomationId="ProfilesRefreshButton"
                        Content="🔄 Refresh" 
                        Command="{Binding RefreshCommand}"
                        Padding="12,8"
                        Background="#3E3E42"
                        Foreground="#CCCCCC"
                        BorderThickness="0"
                        CornerRadius="6" />
            </Grid>
        </Border>
        
        <!-- Bottom Action Bar (Bulk Actions) -->
        <Border DockPanel.Dock="Bottom"
                Background="#2A2D2E"
                BorderBrush="#3E3E42"
                BorderThickness="0,1,0,0"
                Padding="20,15"
                IsVisible="{Binding HasSelection}">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Spacing="12">
                <!-- Selection Count -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount}" 
                               Foreground="#CCCCCC"
                               FontWeight="SemiBold"
                               FontSize="14" />
                    <TextBlock Text="profile(s) selected" 
                               Foreground="#858585"
                               FontSize="14" />
                </StackPanel>
                
                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <!-- Start All Button -->
                    <Button Content="▶ START ALL" 
                            Command="{Binding StartAllSelectedCommand}"
                            Background="Transparent"
                            Foreground="#4CAF50"
                            BorderBrush="#4CAF50"
                            BorderThickness="1"
                            Padding="24,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            CornerRadius="6" />
                    
                    <!-- Delete All Button -->
                    <Button Content="🗑️ DELETE ALL" 
                            Command="{Binding DeleteAllSelectedCommand}"
                            Background="Transparent"
                            Foreground="#F44336"
                            BorderBrush="#F44336"
                            BorderThickness="1"
                            Padding="24,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            CornerRadius="6" />
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Profiles Tree -->
        <TreeView x:Name="ProfilesTree"
                  AutomationProperties.AutomationId="ProfilesList"
                  ItemsSource="{Binding RootNodes}"
                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                  DragDrop.AllowDrop="True"
                  Background="#1E1E1E"
                  Foreground="#CCCCCC"
                  Padding="8,6"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
                </Style>
                <Style Selector="TreeViewItem /template/ ContentPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </TreeView.Styles>
            <TreeView.DataTemplates>
                <!-- Folder row -->
                <TreeDataTemplate DataType="vm:ProfileFolderNodeViewModel"
                                  x:DataType="vm:ProfileFolderNodeViewModel"
                                  ItemsSource="{Binding Children}">
                    <Border Background="Transparent" MinHeight="40" Padding="2,1" HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <TextBlock Grid.Column="0"
                                       Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       Foreground="#E0B34A"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#DDDDDD"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Background="#34383C"
                                        CornerRadius="9"
                                        Padding="7,1"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasProfiles}">
                                    <TextBlock Text="{Binding ProfileCountDisplay}"
                                               FontSize="11"
                                               Foreground="#9AA2AA" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="FolderAction"
                                    Content="&#xE712;"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    ToolTip.Tip="Folder actions">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Rename" Command="{Binding RenameCommand}" />
                                        <MenuItem Header="New subfolder" Command="{Binding NewSubfolderCommand}" />
                                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" Foreground="#F44336" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Border>
                </TreeDataTemplate>

                <!-- Profile row -->
                <TreeDataTemplate DataType="vm:ProfileItemViewModel"
                                  x:DataType="vm:ProfileItemViewModel"
                                  ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="34,26,Auto,Auto,*,Auto"
                          ColumnSpacing="8"
                          MinHeight="48"
                          Margin="0,1"
                          HorizontalAlignment="Stretch">
                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  IsChecked="{Binding IsSelected}" />

                        <Ellipse Grid.Column="1"
                                 Width="10"
                                 Height="10"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Fill="{Binding IsRunning, Converter={StaticResource StatusColorConverter}}" />

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Grid Width="28"
                                  Height="24"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding OsIconTip}">
                                <Viewbox Width="{Binding OsIconBoxSize}"
                                         Height="{Binding OsIconBoxSize}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Stretch="Uniform">
                                    <Path Width="24"
                                          Height="24"
                                          Stretch="Uniform"
                                          Data="{Binding OsIconData}"
                                          Fill="{Binding OsIconFill}" />
                                </Viewbox>
                            </Grid>
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#CCCCCC"
                                       VerticalAlignment="Center"
                                       MaxWidth="220"
                                       TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding TagChips}"
                                          IsVisible="{Binding ShowTags}"
                                          VerticalAlignment="Center"
                                          Margin="2,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TagChipViewModel">
                                        <Border Width="20"
                                                Height="20"
                                                CornerRadius="5"
                                                Background="{Binding Brush}"
                                                ToolTip.Tip="{Binding Name}">
                                            <TextBlock Text="{Binding Glyph}"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Grid.Column="3"
                                   Text="{Binding ProxyDisplay}"
                                   Width="150"
                                   IsVisible="{Binding ShowProxy}"
                                   Foreground="#B0B6BC"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Column="4"
                                Classes="NotesHost"
                                IsVisible="{Binding ShowNotes}"
                                Background="#202326"
                                BorderBrush="#30363D"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="0"
                                Margin="0,4,8,4"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Classes="ProfileNotesTextBox"
                                         Text="{Binding NotesDisplay}"
                                         IsReadOnly="True"
                                         IsVisible="{Binding IsNotesCollapsed}"
                                         MinHeight="34"
                                         MaxHeight="46"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalContentAlignment="Center"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled" />

                                <TextBox Grid.Column="0"
                                         Classes="ProfileNotesTextBox"
                                         Text="{Binding NotesDisplay}"
                                         IsReadOnly="True"
                                         IsVisible="{Binding IsNotesExpanded}"
                                         MinHeight="70"
                                         MaxHeight="190"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                <Button Grid.Column="1"
                                        Classes="NotesToggle"
                                        Content="{Binding NotesToggleIcon}"
                                        Command="{Binding ToggleNotesCommand}"
                                        IsVisible="{Binding HasNotes}"
                                        ToolTip.Tip="{Binding NotesToggleTip}"
                                        Margin="6,3,6,3"
                                        VerticalAlignment="Top" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="5"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,6,0">
                            <Button Classes="PrimaryAction"
                                    Command="{Binding StartCommand}"
                                    IsVisible="{Binding IsStartActionVisible}"
                                    Background="#2E7D32">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                    <TextBlock Text="Start" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="PrimaryAction"
                                    Command="{Binding StopCommand}"
                                    IsVisible="{Binding IsRunningActionVisible}"
                                    Background="#B71C1C">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="PrimaryAction"
                                    IsVisible="{Binding IsImportingCookies}"
                                    IsEnabled="False"
                                    Background="#235A8F">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" />
                                    <TextBlock Text="Importing" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="SecondaryAction"
                                    Content="&#xE712;"
                                    ToolTip.Tip="More actions">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Edit" Command="{Binding EditCommand}" />
                                        <MenuItem Header="Clone" Command="{Binding CloneCommand}" />
                                        <MenuItem Header="Export cookies" Command="{Binding ExportCookiesCommand}" />
                                        <MenuItem Header="Import cookies" Command="{Binding ImportCookiesCommand}" />
                                        <MenuItem Header="Open log" Command="{Binding ViewLogCommand}" />
                                        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" Foreground="#F44336" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </TreeDataTemplate>
            </TreeView.DataTemplates>
        </TreeView>
        
        <!-- Empty State -->
        <Panel IsVisible="{Binding !RootNodes.Count}">
            <StackPanel VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Spacing="15">
                <TextBlock Text="📁" 
                           FontSize="48" 
                           HorizontalAlignment="Center" />
                <TextBlock Text="No profiles yet" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Click 'New Profile' to create your first profile" 
                           Foreground="#858585"
                           FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>
    </DockPanel>
    
</UserControl>
