<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YellowFox.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="880"
        d:DesignHeight="560"
        x:Class="YellowFox.Desktop.Views.PasskeysWindow"
        x:DataType="vm:PasskeysViewModel"
        Icon="/Assets/yellowfox.ico"
        Width="880"
        Height="560"
        MinWidth="640"
        MinHeight="400"
        Background="#1E1E1E"
        Title="{Binding Title}"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="16,12"
                Background="#222629"
                BorderBrush="#3E3E42"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button Content="🔄 Refresh"
                            Command="{Binding RefreshCommand}"
                            Padding="14,7"
                            Background="#3E3E42"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            CornerRadius="5"
                            ToolTip.Tip="Reload the passkey store from disk" />
                    <Button Content="⬇ Export"
                            Command="{Binding ExportCommand}"
                            Padding="14,7"
                            Background="#3E3E42"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            CornerRadius="5"
                            ToolTip.Tip="Save a JSON backup of the stored passkeys" />
                    <Button Content="🗑 Delete"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanDelete}"
                            Padding="14,7"
                            Background="#A33A3A"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="5"
                            ToolTip.Tip="Remove the selected passkey from this profile" />
                    <Button Content="Close"
                            Command="{Binding CloseCommand}"
                            Padding="14,7"
                            Background="#3E3E42"
                            Foreground="#CCCCCC"
                            BorderThickness="0"
                            CornerRadius="5" />
                </StackPanel>

                <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProfileName}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#E6E6E6" />
                    <TextBlock Text="{Binding CountDisplay}"
                               FontSize="12"
                               Foreground="#9AA2AA" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsRunning}"
                Padding="16,8"
                Background="#3A3320"
                BorderBrush="#5A4E2A"
                BorderThickness="0,0,0,1">
            <TextBlock Text="{Binding RunningHint}"
                       TextWrapping="Wrap"
                       Foreground="#E6D9A8"
                       FontSize="12" />
        </Border>

        <DataGrid Grid.Row="2"
                  AutomationProperties.AutomationId="PasskeysList"
                  IsVisible="{Binding HasPasskeys}"
                  ItemsSource="{Binding Passkeys}"
                  SelectedItem="{Binding SelectedPasskey}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  Background="#1E1E1E"
                  Foreground="#CCCCCC"
                  BorderBrush="#3E3E42"
                  RowBackground="#1E1E1E"
                  HeadersVisibility="Column"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  CanUserResizeColumns="True"
                  Margin="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Relying party" Binding="{Binding RpIdDisplay}" Width="2*" />
                <DataGridTextColumn Header="User handle" Binding="{Binding UserHandleDisplay}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="150" />
                <DataGridTextColumn Header="Sign count" Binding="{Binding SignCount}" Width="90" />
                <DataGridTextColumn Header="Credential ID" Binding="{Binding CredentialIdShort}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <Panel Grid.Row="2" IsVisible="{Binding IsEmpty}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        MaxWidth="460">
                <TextBlock Text="🔑"
                           FontSize="44"
                           HorizontalAlignment="Center" />
                <TextBlock Text="No passkeys yet"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Passkeys created in this profile (for example on Facebook or Google) are stored here automatically and restored the next time the profile starts."
                           Foreground="#858585"
                           FontSize="13"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>

        <Border Grid.Row="3"
                Padding="16,8"
                Background="#252526"
                BorderBrush="#3E3E42"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#9AA2AA"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
